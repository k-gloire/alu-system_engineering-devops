#!/usr/bin/env bash
# Installs HAProxy and balances traffic between web-01 and web-02 with roundrobin
sudo apt-get update -y
sudo apt-get install -y haproxy
sudo tee -a /etc/haproxy/haproxy.cfg > /dev/null << 'CFG'

frontend http_front
    bind *:80
    mode http
    default_backend http_back

backend http_back
    mode http
    balance roundrobin
    server 7416-web-01 13.40.32.202:80 check
    server 7416-web-02 35.178.172.14:80 check
CFG
sudo sed -i "s/^ENABLED=.*/ENABLED=1/" /etc/default/haproxy
sudo service haproxy restart

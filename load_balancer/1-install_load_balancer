#!/usr/bin/env bash
# Installs HAProxy and balances traffic between web-01 and web-02 with roundrobin
sudo apt-get update -y
sudo apt-get install -y haproxy
sudo tee /etc/haproxy/haproxy.cfg > /dev/null << 'CFG'
global
    maxconn 2048
    user haproxy
    group haproxy
    daemon
    h1-case-adjust x-served-by X-Served-By

defaults
    mode http
    timeout connect 5000ms
    timeout client 50000ms
    timeout server 50000ms

frontend http_front
    bind *:80
    option h1-case-adjust-bogus-client
    default_backend http_back

backend http_back
    balance roundrobin
    option h1-case-adjust-bogus-server
    server 7416-web-01 13.40.32.202:80 check
    server 7416-web-02 35.178.172.14:80 check
CFG
sudo sed -i "s/^ENABLED=.*/ENABLED=1/" /etc/default/haproxy
sudo service haproxy restart
